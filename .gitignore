# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
wheels/
.venv/
venv/
.env

# Native module built in place by maturin (src/xlspy/_rs_core.*) and its debug symbols
*.pyd
*.so
*.pdb

# Rust
target/

# Tools and caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.nox/
.tox/
/site/
*.log
# Benchmark logs the docs link to are records, not output.
!docs/benchmark-results/*.log

# Test and example output
.pytest-tmp/
.test_tmp/
/tmp/
examples/output/
test_xlsxwriter.xlsx
real_netezza_output.xlsb
# Workbooks written by scripts; the fixtures under tests/data are committed.
*.xlsb
!tests/data/**/*.xlsb

# Editors and local agent config
.vscode/
.vs/
.idea/
.commandcode/
$null
